# ==============================================================================
# Autonomous Quantitative US Investment Bot - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file or private credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Tickertape / DriveWealth Live Execution API
# Run `python scripts/tickertape_auth.py` to automatically authenticate via browser
# Or provide the token directly below:
# ------------------------------------------------------------------------------
TICKERTAPE_TOKEN=your_tickertape_bearer_token_here

# ------------------------------------------------------------------------------
# 2. Alpaca Paper Trading Sandbox ($100,000 USD Virtual Forward Testing)
# Generate free API keys at https://alpaca.markets
# ------------------------------------------------------------------------------
ALPACA_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ------------------------------------------------------------------------------
# 3. Alpha Vantage Technical Indicators (RSI, Moving Averages)
# Claim free API key at https://www.alphavantage.co/support/#api-key
# ------------------------------------------------------------------------------
AV_API_KEY=your_alpha_vantage_key_here

# ------------------------------------------------------------------------------
# 4. Zerodha Kite Connect API (Live Order Execution & Margins)
# Create free personal app at https://developers.kite.trade
# ------------------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URL=http://127.0.0.1:8000/
# Dedicated Indian execution broker: Zerodha Kite Connect v3
PREFERRED_IN_BROKER=zerodha



